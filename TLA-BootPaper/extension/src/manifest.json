{
  "manifest_version": 3,
  "name": "TLA New Tab",
  "version": "1.1",
  "description": "Shows your most-visited sites and your desktop background on the TLA new tab page. Nothing leaves your computer.",
  "permissions": [
    "topSites",
    "favicon",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://ebuskell-source.github.io/Default-wallpaper/TLA-BootPaper/newtab/*"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "update_url": "https://ebuskell-source.github.io/Default-wallpaper/TLA-BootPaper/extension/updates.xml",
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "https://ebuskell-source.github.io/*"
      ]
    }
  ]
}
